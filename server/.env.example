# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sweety?schema=public"

# Port the API listens on.
PORT=4000

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# How long an issued token stays valid (zeit/ms format, e.g. 7d, 24h).
JWT_EXPIRES_IN="7d"

# bcrypt cost factor for password hashing.
BCRYPT_ROUNDS=10

# Origin allowed by CORS (the Vite dev server by default).
CLIENT_ORIGIN="http://localhost:5173"
